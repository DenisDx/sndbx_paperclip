// sndbx per-image overlay generated from the root config.
// Sandbox ids: paperclip
// These are VM defaults. The root config wins every conflict; a root
// array replaces this list entirely. run_at_startup is owned by the root.
{
  "sandboxes": {
    "items": {
      "paperclip": {
        "title": "Paperclip AI company host",
        "image": "paperclip:latest",
        "local_image_id": "paperclip",
        "memory": "${PAPERCLIP_MEMORY:-4G}",
        "cpus": ${PAPERCLIP_CPUS:-2},
        "disk_max": "${PAPERCLIP_DISK_MAX:-20G}",
        "network_traffic_max": "${PAPERCLIP_NETWORK_TRAFFIC_MAX:-100G}",
        "persistent": true,
        "configure_apt_mirror": false,
        "ssh_keys": [],
        "ssh_user": "node",
        "ssh_setup_via_image_hook": true,
        "runtime_contract": {
          "version": 1,
          "environment": {
            "PAPERCLIP_BIND_HOST": "${PAPERCLIP_BIND_HOST:-0.0.0.0}",
            "PAPERCLIP_PORT": "${PAPERCLIP_PORT:-3100}",
            "PAPERCLIP_PUBLIC_URL": "${PAPERCLIP_PUBLIC_URL:-http://localhost:13100}",
            "PAPERCLIP_ALLOWED_HOSTNAMES": "${PAPERCLIP_ALLOWED_HOSTNAMES:-}",
            "BETTER_AUTH_URL": "${BETTER_AUTH_URL:-http://localhost:13100}",
            "BETTER_AUTH_TRUSTED_ORIGINS": "${BETTER_AUTH_TRUSTED_ORIGINS:-http://localhost:13100}"
          },
          "readiness": [
            {
              "type": "http",
              "url": "http://127.0.0.1:${PAPERCLIP_HOST_PORT:-13100}/api/health",
              "attempts": 90,
              "interval_seconds": 1
            }
          ]
        },
        "tmpfs": [
          "/tmp:rw,exec,size=512m",
          "/run:rw,size=64m"
        ],
        "shared_directories": [
          {
            "host_path": "${SNDBX_ROOT}/images/paperclip/data",
            "guest_path": "/paperclip",
            "mount_type": "dir",
            "source_type": "directory",
            "permission": "rw",
            "required": true,
            "create_if_missing": true
          },
          {
            "host_path": "${SNDBX_ROOT}/images/paperclip/.env",
            "guest_path": "/paperclip/.env",
            "mount_type": "file",
            "source_type": "file",
            "permission": "ro",
            "required": false
          }
        ],
        "port_bindings": [
          {
            "bind_host": "${PAPERCLIP_SSH_BIND_HOST:-0.0.0.0}",
            "vm_port": 22,
            "publish_port": ${PAPERCLIP_SSH_HOST_PORT:-12022}
          },
          {
            "bind_host": "${PAPERCLIP_BIND_HOST:-0.0.0.0}",
            "vm_port": 3100,
            "publish_port": ${PAPERCLIP_HOST_PORT:-13100}
          }
        ]
      }
    }
  }
}
