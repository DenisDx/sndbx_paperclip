# Copy this file to .env before starting Paperclip. Keep .env private and use
# shell-compatible KEY=value entries only.

# Paperclip runtime identity. Set these to the UID/GID of the user that runs
# sndbx (see `id -u` / `id -g`) so files created under data/ belong to that
# user. The container remaps its internal node account at startup.
PAPERCLIP_UID=1000
PAPERCLIP_GID=1000

# Paperclip server bind and published ports.
# PAPERCLIP_BIND_HOST also controls the host interface the API is published on.
PAPERCLIP_BIND_HOST=0.0.0.0
PAPERCLIP_PORT=3100
PAPERCLIP_HOST_PORT=13100
# Base URL users and remote agents reach the UI/API at (set the LAN address).
PAPERCLIP_PUBLIC_URL=http://localhost:13100
# Extra hostnames the instance accepts beyond PAPERCLIP_PUBLIC_URL, comma-separated.
PAPERCLIP_ALLOWED_HOSTNAMES=

# SSH publication used by sndbx (guest port 22).
PAPERCLIP_SSH_BIND_HOST=0.0.0.0
PAPERCLIP_SSH_HOST_PORT=12022

# Deployment mode: "authenticated" requires login, "local_trusted" skips auth.
PAPERCLIP_DEPLOYMENT_MODE=authenticated
# "private" = LAN only, "public" = internet-facing (use with TLS).
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Required secret for session signing. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional model provider keys (at least one is needed for agents to work).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Runtime.
TZ=UTC
